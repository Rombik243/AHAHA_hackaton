DATABASE_URL=sqlite+aiosqlite:///./app.db
AUTO_CREATE_TABLES=true
LLM_ENABLED=true
TEST_MODE=false
MAX_RUN_SECONDS=180
OLLAMA_URL=http://localhost:11434
OLLAMA_MODEL=qwen2.5:7b
OLLAMA_RETRIES=1
OLLAMA_TIMEOUT=60
# Per-page/request network limit, separate from the total TEST_MODE run deadline.
REQUEST_TIMEOUT=15
WEB_SEARCH_PROVIDER=searxng
# For live search, use searxng (self-hosted) or brave (requires an API key).
BRAVE_API_KEY=
SEARXNG_URL=http://localhost:8080
MAX_SEARCH_ITERATIONS=2
SEARCH_RESULT_LIMIT=10
MAX_PAGES_PER_LOT=20
DEFAULT_DELIVERY_REGION=Санкт-Петербург
MAX_RELATED_PAGES=3
RELEVANCE_CHUNK_CHARS=10000
MAX_RELEVANCE_CHUNKS_PER_PAGE=30
RELEVANCE_CONTEXT_CHARS=24000
RELEVANCE_CONTEXT_TOKENS=32768
PAGE_ARCHIVE_PATH=tmp/page_archive
MAX_PAGE_ARCHIVE_BYTES=500000000
MAX_QUERIES_PER_ITERATION=3
MAX_UPLOAD_BYTES=5000000
MAX_ENRICHMENT_UPLOAD_BYTES=512000000
MAX_ENRICHMENT_SUPPLIERS=1000
MAX_ENRICHMENT_RECORDS=100000
MAX_ENRICHMENT_PAGES_PER_SUPPLIER=4
CANDIDATE_TEXT_MIN_SIMILARITY=0.08
UNKNOWN_RATIO_THRESHOLD=0.5
CONFIRMED_WEIGHT=1.0
CONTRADICTED_WEIGHT=-2.0
UNKNOWN_WEIGHT=0.0
HISTORY_WIN_BONUS=2.0
MAX_HISTORY_BONUS=5.0
OKPD2_MIN_SIMILARITY=0.45
OKPD2_MIN_MARGIN=0.05
CORS_ORIGINS=["http://localhost:3000","http://localhost:5173"]
LOG_LEVEL=INFO
