DATABASE_URL=sqlite+aiosqlite:///./app.db
AUTO_CREATE_TABLES=true
LLM_ENABLED=true
OLLAMA_URL=http://localhost:11434
OLLAMA_MODEL=qwen2.5:7b
OLLAMA_RETRIES=1
OLLAMA_TIMEOUT=60
WEB_SEARCH_PROVIDER=searxng
# For live search, use searxng (self-hosted) or brave (requires an API key).
BRAVE_API_KEY=
SEARXNG_URL=http://localhost:8080
MAX_SEARCH_ITERATIONS=2
SEARCH_RESULT_LIMIT=10
MAX_PAGES_PER_LOT=20
MAX_QUERIES_PER_ITERATION=3
REQUEST_TIMEOUT=15
MAX_UPLOAD_BYTES=5000000
CANDIDATE_TEXT_MIN_SIMILARITY=0.08
UNKNOWN_RATIO_THRESHOLD=0.5
CONFIRMED_WEIGHT=1.0
CONTRADICTED_WEIGHT=-2.0
UNKNOWN_WEIGHT=0.0
HISTORY_WIN_BONUS=2.0
MAX_HISTORY_BONUS=5.0
OKPD2_MIN_SIMILARITY=0.45
OKPD2_MIN_MARGIN=0.05
CORS_ORIGINS=["http://localhost:3000","http://localhost:5173"]
LOG_LEVEL=INFO
